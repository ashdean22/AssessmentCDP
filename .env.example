# Supabase (server only — never expose the service role key to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Dashboard login
APP_PASSWORD=change-me
SESSION_SECRET=64-hex-chars

# Webhook HMAC signing (shared with the mobile app)
WEBHOOK_SECRET=64-hex-chars

# Masked subscriber IDs shown to the AI
MASK_SECRET=64-hex-chars

# Chat assistant
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# Voice assistant
VAPI_PRIVATE_KEY=xxx
NEXT_PUBLIC_VAPI_PUBLIC_KEY=xxx
VAPI_ASSISTANT_ID=xxx
NEXT_PUBLIC_VAPI_ASSISTANT_ID=xxx
VAPI_SERVER_SECRET=xxx

# beehiiv (optional; the push is a mock and sends nothing — these only fill in the shown payload)
BEEHIIV_PUBLICATION_ID=pub_xxx
BEEHIIV_API_KEY=xxx
